{$HOSTNAME}:{$CADDY_PORT} {
	tls /certs/localhost.crt /certs/localhost.key


    # Redirect interno opzionale
    #redir / /a/heriverse 302

    request_body {
        max_size {$MAX_BODY_SIZE}
    }

    handle_path /server/* {
        reverse_proxy {$SERVER_HOST}:{$SERVER_PORT}
    }

    handle /auth* {
        reverse_proxy {$KEYCLOAK_HOST}:{$KEYCLOAK_PORT}
    }

    handle_path /couchdb/* {
        reverse_proxy {$COUCHDB_HOST}:{$COUCHDB_PORT}
    }

      handle_path /minio/* {
    reverse_proxy {$S3_HOST}:{$S3_PORT}
  }

  handle_path /minio-console/* {
    reverse_proxy {$S3_HOST}:{$S3_CONSOLE_PORT}
  }

    handle /* {
        reverse_proxy {$FRONTEND_HOST}:{$FRONTEND_PORT}
    }


}